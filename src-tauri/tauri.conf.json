{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ezyPlayer",
  "version": "0.9.0",
  "identifier": "app.ezyrider.ezyplayer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ezyPlayer",
        "width": 1920,
        "height": 1080,
        "minWidth": 1000,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' asset: http://asset.localhost http://127.0.0.1:* data: blob:; media-src 'self' asset: http://asset.localhost http://127.0.0.1:* blob:; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.14"
    },
    "linux": {
      "deb": {
        "depends": [
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-libav",
          "gstreamer1.0-tools"
        ],
        "section": "sound"
      }
    },
    "publisher": "ezyApps",
    "copyright": "© 2026 ezyApps",
    "category": "Music",
    "shortDescription": "Live-event audio & video cue player",
    "longDescription": "ezyPlayer is a professional cue player for live events: a QLab-style cue grid with GO sequencing, a playlist with crossfades and ducking, video and slides output to a second screen, and a native low-latency audio engine with multichannel routing (ASIO on Windows).",
    "homepage": "https://ezyplayer.app",
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": [
          "English",
          "Catalan",
          "Spanish"
        ],
        "displayLanguageSelector": false,
        "startMenuFolder": "ezyPlayer"
      }
    }
  }
}
